# Supabase (Project settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only. Used for post-call scoring writes and webhooks. Never expose to the client.
SUPABASE_SERVICE_ROLE_KEY=

# ElevenLabs Conversational AI
ELEVENLABS_API_KEY=
# Create once with `pnpm elevenlabs:setup`, then paste the printed id here
ELEVENLABS_AGENT_ID=
# Optional: post-call webhook secret (ElevenLabs → Settings → Webhooks). Scoring also runs without it.
ELEVENLABS_WEBHOOK_SECRET=
# Optional: LLM that plays the prospect (default claude-sonnet-5)
ELEVENLABS_AGENT_LLM=claude-sonnet-5

# Anthropic: call scoring and knowledge digests
ANTHROPIC_API_KEY=

# Stripe (test keys first). Prices come from `pnpm stripe:setup`; webhook secret from the dashboard endpoint.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_STARTER_MONTHLY=
STRIPE_PRICE_STARTER_ANNUAL=
STRIPE_PRICE_TEAM_MONTHLY=
STRIPE_PRICE_TEAM_ANNUAL=
# Set to 1 once Stripe Tax is enabled on the account
STRIPE_AUTOMATIC_TAX=

# Resend for invites and lifecycle emails. Without a key, emails are logged and skipped.
RESEND_API_KEY=
EMAIL_FROM="SDRCoach <hello@sdrcoach.io>"

# Protects the daily lifecycle cron (Vercel sends it as a Bearer token automatically)
CRON_SECRET=

# Internal admin console (/admin): extra comma-separated emails beyond the founders listed in src/lib/auth.ts
ADMIN_EMAILS=
# Estimated voice cost per minute, used for the admin cost view only
ELEVENLABS_COST_PER_MIN=0.10
# Estimated cost of the prospect model per conversation minute (billed by ElevenLabs), admin cost view only
ELEVENLABS_LLM_COST_PER_MIN=0.02

# Legal entity shown in the footer, privacy and terms pages (leave unset until incorporated)
NEXT_PUBLIC_LEGAL_NAME=
NEXT_PUBLIC_LEGAL_ADDRESS=
NEXT_PUBLIC_LEGAL_COUNTRY=

# Sales contact shown on pricing and upgrade pages
NEXT_PUBLIC_SALES_EMAIL=hello@sdrcoach.io
# Per-org daily call cap (abuse guard, independent of plan)
CALLS_PER_ORG_PER_DAY=200

# Public origin, used for invite links and auth redirects
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Dev only: render every screen against in-memory fixture data, no database or login needed
# SDRCOACH_DEMO=1

# Analytics (loaded only after cookie consent), PostHog EU cloud
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com
# Skip the DNS MX check on signup (local development only)
# SKIP_MX_CHECK=1
